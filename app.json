{
  "expo": {
    "name": "カーケイボー",
    "slug": "carkeibo",
    "scheme": "carkeibo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "株式会社たにぐち自動車のクルマの家計簿アプリ。オイル交換の目安と維持費がひと目で分かります。",
    "ios": {
      "bundleIdentifier": "app.carkeibo",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.carkeibo",
      "adaptiveIcon": {
        "backgroundColor": "#f5f5f7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f5f5f7"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "整備工場の連携用QRコードの読み取りと、レシートやメーターの撮影にカメラを使います。",
          "recordAudioAndroid": false,
          "microphonePermission": "話した内容から記録を入力するためにマイクを使います。"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0071e3"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "話した内容から記録を入力するためにマイクを使います。",
          "speechRecognitionPermission": "話した内容を文字にして、日付・金額・走行距離を入力するために音声認識を使います。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "撮っておいたレシートやメーターの写真から記録を入力するために写真を使います。",
          "cameraPermission": "整備工場の連携用QRコードの読み取りと、レシートやメーターの撮影にカメラを使います。",
          "microphonePermission": "話した内容から記録を入力するためにマイクを使います。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "近くの整備工場を距離の近い順に表示するために、現在地を使います。",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4dbab413-c3d8-412d-95d8-1c4f4f7958fb"
      }
    },
    "owner": "cartrust"
  }
}
