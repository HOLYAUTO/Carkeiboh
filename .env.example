# アプリに埋め込まれる公開設定（EXPO_PUBLIC_ はアプリから読める。秘密情報は入れない）
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 【要確認】文面が用意されたら設定する
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# --- 以下はサーバー（Supabase Edge Functions の secrets）用。アプリの .env には書かない ---
# LEDRA_API_BASE_URL=https://<ledra-host>/api/passport
# LEDRA_API_KEY=<カーケイボー専用に Ledra 管理画面で発行したキー>
# CRON_SECRET=<ランダムな長い文字列。cron.example.sql の Vault にも同じ値>
# EXPO_ACCESS_TOKEN=<Expo Push のアクセストークン（任意・推奨）>
